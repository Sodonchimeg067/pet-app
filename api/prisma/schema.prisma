generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           String    @default("user")
  isActive       Boolean   @default(true) @map("is_active")
  consentGiven   Boolean   @default(false) @map("consent_given")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  pets      Pet[]
  listings  Listing[]
  replies   ListingReply[]
  reviews   Review[]
  reports   Report[]
  auditLogs AuditLog[]

  @@map("users")
}

model Pet {
  id        Int       @id @default(autoincrement())
  ownerId   Int       @map("owner_id")
  name      String
  species   String
  breed     String?
  gender    String?
  birthDate DateTime? @map("birth_date")
  photo     String?
  createdAt DateTime  @default(now()) @map("created_at")

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  healthRecords HealthRecord[]
  listings      Listing[]

  @@index([ownerId])
  @@map("pets")
}

model VaccineRule {
  id           Int    @id @default(autoincrement())
  type         String
  name         String
  intervalDays Int    @map("interval_days")

  healthRecords HealthRecord[]

  @@map("vaccine_rules")
}

model HealthRecord {
  id          Int       @id @default(autoincrement())
  petId       Int       @map("pet_id")
  ruleId      Int?      @map("rule_id")
  type        String
  name        String
  date        DateTime
  nextDueDate DateTime? @map("next_due_date")

  pet       Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  rule      VaccineRule? @relation(fields: [ruleId], references: [id])
  reminders Reminder[]

  @@index([petId])
  @@index([nextDueDate])
  @@map("health_records")
}

model Reminder {
  id       Int       @id @default(autoincrement())
  recordId Int       @map("record_id")
  dueDate  DateTime  @map("due_date")
  channel  String    @default("email")
  status   String    @default("pending")
  sentAt   DateTime? @map("sent_at")

  record HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, dueDate, channel])
  @@map("reminders")
}

model Listing {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  petId       Int?     @map("pet_id")
  type        String
  species     String
  color       String?
  features    String?
  location    String
  lat         Float?
  lng         Float?
  eventDate   DateTime @map("event_date")
  description String?
  photo       String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet     Pet?           @relation(fields: [petId], references: [id], onDelete: SetNull)
  replies ListingReply[]

  @@index([type, status])
  @@map("listings")
}

model ListingReply {
  id        Int      @id @default(autoincrement())
  listingId Int      @map("listing_id")
  userId    Int      @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("listing_replies")
}

model ServiceProvider {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  address   String
  phone     String?
  workHours String?  @map("work_hours")
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt @map("updated_at")

  prices  PriceItem[]
  reviews Review[]

  @@index([category])
  @@map("service_providers")
}

model PriceItem {
  id          Int      @id @default(autoincrement())
  providerId  Int      @map("provider_id")
  serviceName String   @map("service_name")
  source      String?
  price       Int
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("price_items")
}

model Review {
  id         Int      @id @default(autoincrement())
  providerId Int      @map("provider_id")
  userId     Int      @map("user_id")
  rating     Int
  comment    String?
  status     String   @default("visible")
  createdAt  DateTime @default(now()) @map("created_at")

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int      @map("reporter_id")
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  topic       String
  content     String
  photo       String?
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("articles")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int      @map("admin_id")
  action    String
  targetId  Int?     @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}